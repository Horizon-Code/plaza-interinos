DATABASE_URL="postgresql://user:pass@localhost:5432/tuplaza?schema=public"
JWT_SECRET="cambia-esto-en-produccion"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
CAMPAIGN_PRICE_CENTS="2499"
CORS_ORIGIN="http://localhost:4200"
PORT="3000"

# ── Acceso por enlace magico ─────────────────────────────────────────────
# Base sobre la que se construye el enlace del correo. Sin ella se usa
# CORS_ORIGIN y, en su defecto, http://localhost:4200.
APP_URL="http://localhost:4200"
# Envio real del correo. SIN esta clave la API no falla: escribe el enlace en
# su propio log, que es suficiente para desarrollar en local.
RESEND_API_KEY=""
MAIL_FROM="PlazaInterinos <acceso@plazainterinos.es>"
# Minutos que vive el enlace del correo y duracion de la sesion ya dentro.
LOGIN_LINK_MINUTES="15"
JWT_EXPIRES_IN="90d"
# Atajo SOLO para desarrollo: si no hay RESEND_API_KEY, la respuesta de
# /auth/magic-link incluye el enlace para poder entrar sin leer el log.
# NUNCA en produccion: con esto cualquiera entra en cualquier cuenta.
DEV_SHOW_LOGIN_LINK="false"

# Identificador publico de la aplicacion en Google Cloud, para "Entrar con
# Google". Sin el, nadie puede entrar: la API responde que no esta configurado
# y la web no pinta el boton. No es un secreto (viaja en cada peticion de
# acceso), pero se define como variable para no recompilar la web al cambiarlo.
GOOGLE_CLIENT_ID=""
